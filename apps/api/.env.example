# Connexion PostgreSQL (Supabase, Neon ou local). PostGIS requis pour la recherche par distance.
DATABASE_URL="postgresql://postgres:MOT_DE_PASSE@db.xxxx.supabase.co:5432/postgres"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# URL du frontend (CORS + redirection OAuth)
WEB_URL="http://localhost:3000"

# Port de l'API
PORT=3001

# Google OAuth (optionnel — l'API démarre sans)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"
